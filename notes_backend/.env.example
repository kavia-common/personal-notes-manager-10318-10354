# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Database selection: sqlite3 (default), pg, mysql2
DB_CLIENT=sqlite3

# SQLite configuration (used when DB_CLIENT=sqlite3)
DB_SQLITE_FILENAME=./data/notes.sqlite

# Alternative: URL-based connection string (e.g., for pg or mysql2)
# DB_URL=postgres://user:password@host:5432/dbname

# Or discrete settings (for pg/mysql2)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=user
# DB_PASSWORD=pass
# DB_NAME=notesdb

# Migrations
DB_RUN_MIGRATIONS=true

# Optional: Path to .env file if running from another directory
# DOTENV_PATH=/path/to/.env
